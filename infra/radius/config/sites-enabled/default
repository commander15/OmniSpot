server default {
    listen {
        type = auth
        ipaddr = *
        port = 1812
    }

    listen {
        type = acct
        ipaddr = *
        port = 1813
    }

    # Processing incoming Access-Request
    authorize {
        filter_username
        preprocess
        
        # 1. First try REST API
        rest
        
        # 2. Local users file fallback (optional testing)
        # files

        # Enable PAP / Cleartext password verification
        pap
    }

    # Authentication phase
    authenticate {
        Auth-Type PAP {
            pap
        }
    }

    # Post-Auth (Sends response back to MikroTik)
    post-auth {
        # Uncomment if you want REST to log successful logins
        # rest
        
        Post-Auth-Type REJECT {
            # Log rejected attempts
            attr_filter.access_reject
        }
    }

    # Accounting phase
    accounting {
        detail
        rest
    }
}
