rest {
    connect_uri = "http://127.0.0.1:8000/api/radius"

    timeout = 10
    connect_timeout = 5

    header {
        Content-Type = "application/json"
        Accept = "application/json"
    }

    authorize {
        uri = "${..connect_uri}/authorize"
        method = 'post'
        body = 'json'
        
        # Map HTTP Status Codes
        response {
            200 = ok
            204 = ok
            401 = reject
            403 = reject
            404 = userlock
        }

        # Inject returned JSON fields into the RADIUS reply payload
        reply = 'reply'
    }

    accounting {
        uri = "${..connect_uri}/accounting"
        method = 'post'
        body = 'json'
    }
}
