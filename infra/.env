APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# HTTP
HTTP_ROOT=
HTTP_PORT=8080
HTTPS_PORT=8443

# DB
DB_HOST=postgres
# DB_PORT=3306
DB_DATABASE=omnispot
DB_USERNAME=admin
DB_PASSWORD=admin

# REDIS
REDIS_HOST=redis
